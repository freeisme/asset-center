GITEA_VERSION=1.27.0
GITEA_DB_IMAGE=postgres:14-alpine
GITEA_UID=1000
GITEA_GID=1000

# Replace these values before starting Gitea.
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=replace-with-a-long-random-password

# Use the externally reachable URL and SSH host name.
GITEA_DOMAIN=git.example.com
GITEA_ROOT_URL=https://git.example.com/
GITEA_SSH_DOMAIN=git.example.com

# Use 127.0.0.1 when Nginx or another reverse proxy terminates HTTP.
GITEA_HTTP_BIND=0.0.0.0
GITEA_HTTP_PORT=3000
GITEA_SSH_BIND=0.0.0.0
GITEA_SSH_PORT=2222

# Keep false until the first administrator has been created.
GITEA_INSTALL_LOCK=false
